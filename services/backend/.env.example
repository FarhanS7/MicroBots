# MicroBots Backend Configuration Example
# Copy to .env for local development

# Application Settings
ENVIRONMENT=development
LOG_LEVEL=INFO
SECRET_KEY=change-this-in-production-secret-key-32bytes

# Database Configuration
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/microbots

# Temporal Orchestration Service
TEMPORAL_HOST=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=microbots-tasks

# Model Provider Secrets (Optional/Development Stubs)
OPENAI_API_KEY=sk-placeholder
ANTHROPIC_API_KEY=sk-ant-placeholder
