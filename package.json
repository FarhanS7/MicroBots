{
  "name": "microbots-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "MicroBots Monorepo Root",
  "scripts": {
    "build": "pnpm --filter @microbots/protocol build && pnpm --filter @microbots/web build",
    "test:protocol": "pnpm --filter @microbots/protocol test",
    "test:unit": "cd services/backend && python -m pytest tests/unit/ -v",
    "typecheck": "pnpm --filter @microbots/protocol build && pnpm --filter @microbots/web exec tsc --noEmit",
    "docs:check": "python scripts/check_docs.py"
  },
  "devDependencies": {
    "prettier": "^3.2.5"
  }
}
